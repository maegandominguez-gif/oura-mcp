PORT="3100"

# Oura sign-in (OAuth). Use the same Oura app as ../server, and add this
# tracker's callback URL to the app's redirect URIs in the Oura developer portal.
CLIENT_ID=""
CLIENT_SECRET=""
REDIRECT_URL="http://localhost:3100/auth/oura/callback"

# Password for the whole app. Leave empty locally; set it when deployed,
# since the app is then reachable at a public URL.
APP_PASSWORD=""

# Where the local Deno KV database file is written (ignored on Deno Deploy)
KV_PATH="./tracker.kv"
